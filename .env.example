# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env.

#── Banco de dados (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartyentregas
DB_USER=postgres
DB_PASS=TROQUE_POR_SENHA_FORTE_ALEATORIA

#── Autenticação JWT ────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA

#── E-mail (Gmail SMTP) ─────────────────────────────────────────────────────────
# App Password gerada em: myaccount.google.com/apppasswords
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

#── Mapbox (rotas no mapa) ──────────────────────────────────────────────────────
# Cadastro gratuito em: account.mapbox.com → Tokens → Create a token
# Permissões necessárias: Directions (public token padrão já serve)
MAPBOX_TOKEN=pk.OBTER_EM_ACCOUNT_MAPBOX_COM

#── Firebase Cloud Messaging (push notifications) ──────────────────────────────
# Obter em: Console Firebase → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FCM_PROJECT_ID=seu-projeto-id
FCM_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nCONTEÚDO_DA_CHAVE\n-----END RSA PRIVATE KEY-----\n"

#── Mercado Pago ────────────────────────────────────────────────────────────────
# Obter em: mercadopago.com.br/developers → Sua aplicação → Credenciais de teste / produção
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
