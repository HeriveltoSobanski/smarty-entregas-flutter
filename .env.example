# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env.

#── Banco de dados (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartyentregas
DB_USER=postgres
DB_PASS=TROQUE_POR_SENHA_FORTE_ALEATORIA

#── Autenticação JWT ────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA

#── E-mail (Gmail SMTP) ─────────────────────────────────────────────────────────
# App Password gerada em: myaccount.google.com/apppasswords
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

#── OpenRouteService (rotas no mapa) ────────────────────────────────────────────
# Cadastro gratuito em: openrouteservice.org
ORS_API_KEY=OBTER_EM_OPENROUTESERVICE_ORG

#── Firebase Cloud Messaging (push notifications) ──────────────────────────────
# Obter em: Console Firebase → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FCM_PROJECT_ID=seu-projeto-id
FCM_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nCONTEÚDO_DA_CHAVE\n-----END RSA PRIVATE KEY-----\n"
